{
  "$schema": "web/node_modules/wrangler/config-schema.json",
  // 顶层是给别人部署用的模板（Deploy to Cloudflare 按钮与 `bun run deploy`）；chat.jaze.top 的配置在 env.production，
  // 用 `bun run deploy:production` 发布。见 docs/adr/0014-template-config-at-top-level.md
  // 静态资源由 web 的 vite 构建产出（@cloudflare/vite-plugin 负责填入目录）
  // 本地开发由 .dev.vars 覆盖 vars 与机密（见 .dev.vars.example 与 README.md）
  "name": "web-chat-app",
  "main": "server/src/index.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  // 只从 BETTER_AUTH_URL 访问：其他 Origin 过不了 /ws 与 /api 的 Origin 检查，媒体桶的 CORS 也不放行。
  // 模板没有自定义域名，用 workers.dev；预览地址同样过不了 Origin 检查，关掉
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "USER", "class_name": "UserDO" },
      { "name": "CHAT", "class_name": "ChatDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserDO", "ChatDO"] }],
  // 不写 database_id：按钮部署与 wrangler deploy 都会自动创建
  "d1_databases": [{ "binding": "DIRECTORY", "database_name": "web-chat-app-directory", "migrations_dir": "server/migrations" }],
  // 媒体桶：Worker 用它删除对象；上传走 S3 API 的预签名 PUT，读取走自定义域名（见 docs/architecture/05-media.md）。
  // 本地开发时这个绑定是模拟的，删除只作用于本地；预签名上传则直达真实的桶
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "web-chat-app-media" }],
  // 部署后填写（README § 部署后），改完提交到仓库重新构建：MEDIA_ORIGIN 与 VAPID_PUBLIC_KEY 在构建时注入前端
  "vars": {
    // 应用对外的地址，例如 https://web-chat-app.<子域>.workers.dev
    "BETTER_AUTH_URL": "",
    // IdP 的 /.well-known/openid-configuration 与登记的 client_id
    "OAUTH_DISCOVERY_URL": "",
    "OAUTH_CLIENT_ID": "",
    // 预签名 PUT 的 S3 端点：https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com/{R2_BUCKET}；R2_BUCKET 必须与 r2_buckets 的桶名一致
    "R2_ACCOUNT_ID": "",
    "R2_BUCKET": "web-chat-app-media",
    // 媒体桶的自定义域名，例如 https://r2.example.com
    "MEDIA_ORIGIN": "",
    // 对象键前缀：与开发环境共用一个桶时，开发环境在 .dev.vars 中设为 dev/（30 天后自动删除）
    "MEDIA_KEY_PREFIX": "",
    // 可选：Web Push 的 VAPID 公钥，与机密 VAPID_PRIVATE_KEY 成对；留空则不提供推送通知
    "VAPID_PUBLIC_KEY": ""
  },
  "observability": { "enabled": true },
  "env": {
    // chat.jaze.top。绑定与 vars 不从顶层继承，逐项写全；name 必须保持 web-chat，否则 Durable Object 的数据对不上
    "production": {
      "name": "web-chat",
      "routes": [{ "pattern": "chat.jaze.top", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      "durable_objects": {
        "bindings": [
          { "name": "USER", "class_name": "UserDO" },
          { "name": "CHAT", "class_name": "ChatDO" }
        ]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserDO", "ChatDO"] }],
      "d1_databases": [
        {
          "binding": "DIRECTORY",
          "database_name": "web-chat-directory",
          "database_id": "d084a21d-efed-4784-b69f-cbecf8537ea9",
          "migrations_dir": "server/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "web-chat" }],
      "vars": {
        "BETTER_AUTH_URL": "https://chat.jaze.top",
        // 开发与生产共用同一个 IdP client，两个回调地址都要在 IdP 登记
        "OAUTH_DISCOVERY_URL": "https://account.jaze.top/api/auth/.well-known/openid-configuration",
        "OAUTH_CLIENT_ID": "sHQuhIyOrRjGkPAsRaKNPMKOcLxIxQzZ",
        "R2_ACCOUNT_ID": "02742d0dc0f623b24977b1e8d7333bea",
        "R2_BUCKET": "web-chat",
        // 开发与生产共用一个桶，见 docs/architecture/05-media.md § 分发
        "MEDIA_ORIGIN": "https://r2.chat.jaze.top",
        "MEDIA_KEY_PREFIX": "",
        "VAPID_PUBLIC_KEY": "BKQwcINEBruDbVIkGrLbLhfvB50UJB5B4TIZAhYpirVUUOIhclD5KhcsXlXKIFchgn1wS1R5flE1k18t1lVxcJY"
      }
    }
  }
}

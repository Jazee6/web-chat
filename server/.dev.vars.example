# 复制为 .dev.vars 并填写（.dev.vars 不提交）
# wrangler.jsonc 的 vars 是生产值，本地开发覆盖为 vite 的地址
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=至少 32 字节的随机值，例如 `openssl rand -base64 32`
# IdP 的 discovery 地址与 client_id 已在 wrangler.jsonc 中，这里只填密钥
OAUTH_CLIENT_SECRET=
# R2 → Manage API tokens 创建的 S3 令牌（Object Read & Write，限定桶 web-chat-media）
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 开发环境上传的对象放在 dev/ 下，由桶的生命周期规则 30 天后删除
MEDIA_KEY_PREFIX=dev/
# Web Push 的 VAPID 私钥（base64url，32 字节）；公钥是 shared/src/protocol 的 VAPID_PUBLIC_KEY，两者必须成对
VAPID_PRIVATE_KEY=
# 可选：通话的 Realtime TURN key 与群组通话的 Realtime SFU App
TURN_KEY_ID=
TURN_KEY_API_TOKEN=
SFU_KEY_ID=
SFU_KEY_API_TOKEN=

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-chat",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  // 静态资源由 web 的 vite 构建产出（@cloudflare/vite-plugin 负责填入目录）
  // 顶层是生产配置；本地开发由 .dev.vars 覆盖 vars（见 .dev.vars.example 与 README.md）
  "routes": [{ "pattern": "chat.jaze.top", "custom_domain": true }],
  // 只从 chat.jaze.top 访问：其他 Origin 过不了 /ws 与 /api 的 Origin 检查，媒体桶的 CORS 也不放行
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "USER", "class_name": "UserDO" },
      { "name": "CHAT", "class_name": "ChatDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserDO", "ChatDO"] }],
  "d1_databases": [
    {
      "binding": "DIRECTORY",
      "database_name": "web-chat-directory",
      // 部署前用 `wrangler d1 create web-chat-directory` 生成后替换
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // 媒体桶：Worker 用它删除对象；上传走 S3 API 的预签名 PUT，读取走自定义域名（见 docs/architecture/05-media.md）。
  // 本地开发时这个绑定是模拟的，删除只作用于本地；预签名上传则直达真实的桶
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "web-chat-media" }],
  "vars": {
    "BETTER_AUTH_URL": "https://chat.jaze.top",
    // 开发与生产共用同一个 IdP client，两个回调地址都要在 IdP 登记
    "OAUTH_DISCOVERY_URL": "https://account.jaze.top/api/auth/.well-known/openid-configuration",
    "OAUTH_CLIENT_ID": "sHQuhIyOrRjGkPAsRaKNPMKOcLxIxQzZ",
    // 预签名 PUT 的 S3 端点：https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com/{R2_BUCKET}
    "R2_ACCOUNT_ID": "02742d0dc0f623b24977b1e8d7333bea",
    "R2_BUCKET": "web-chat-media",
    // 对象键前缀：开发与生产共用一个桶，开发环境在 .dev.vars 中设为 dev/（30 天后自动删除）
    "MEDIA_KEY_PREFIX": ""
  },
  "observability": { "enabled": true }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-chat",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-19",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "port": 3001,
  },
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "vars": {
    "EASY_AUTH_URL": "https://account.jaze.top",
    "BETTER_AUTH_URL": "https://s.chat.jaze.top",
    "EASY_AUTH_CLIENT_ID": "fvTSOvbniIAlmwBSLJIMZYxlOymzxcUw",
    "SITE_URL": "https://chat.jaze.top",
    "AI_GATEWAY_ID": "jaz",
    "VAPID_PUBLIC_KEY": "BMqwA_M-5Fq5k4t0XbnkBF6__qYoMlFeHkwOjkA4XRk688YJJ3OrsNcnhiVguGixhbQAmwAKl7qaT30nvCVy5UE",
    "VAPID_SUBJECT": "mailto:admin@chat.jaze.top",
  },
  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATION_QUEUE",
        "queue": "room-notifications",
      },
    ],
    "consumers": [
      {
        "queue": "room-notifications",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 0,
      },
    ],
  },
  "ai": {
    "binding": "AI",
  },
  "d1_databases": [
    {
      "binding": "web_chat",
      "database_name": "web-chat",
      "database_id": "06895244-713a-4eab-a19f-be610e81fb16",
      "migrations_dir": "drizzle/d1",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "Room",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"],
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILE",
      "bucket_name": "web-chat",
    },
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true,
    },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
  },
  "placement": {
    "mode": "smart",
  },
}
